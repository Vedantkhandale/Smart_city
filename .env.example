# Socket.IO: use a specific frontend origin in production instead of *
SOCKETIO_CORS_ORIGINS=*

# Meta WhatsApp Cloud API (never commit real values)
WHATSAPP_ACCESS_TOKEN=replace_with_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_GRAPH_API_VERSION=v23.0

# A default department/control-room number in E.164 format without +.
WHATSAPP_RECIPIENT=919999999999

# Optional department-specific routing; these override WHATSAPP_RECIPIENT.
WHATSAPP_RECIPIENT_TRAFFIC=
WHATSAPP_RECIPIENT_PWD=
WHATSAPP_RECIPIENT_SANITATION=
WHATSAPP_RECIPIENT_WATER=

# Optional: set this if your WhatsApp business account requires an approved template.
# The template body must accept: reference, severity, zone (in that order).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
